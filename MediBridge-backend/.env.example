# Copy this file to .env and replace the placeholders locally.
APP_NAME=MediBridge API
ENVIRONMENT=development
API_PREFIX=/api
DATABASE_URL=postgresql+psycopg://DB_USER:DB_PASSWORD@localhost:5432/medibridge
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=20
REFRESH_TOKEN_EXPIRE_DAYS=14
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
GEMINI_API_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
